{emailSubject}{if $requested}Review requested{else}Review request was canceled{/if}{/emailSubject}
<h1>{if $requested}Review requested{else}Review request canceled{/if} for solution #{$attempt} of '{$assignment}' assignment</h1>

<p>
    {if $requested}A code review was requested{else}A review request{/if} for solution
    <strong>#{$attempt}</strong>{if !$requested} was canceled{/if}.
</p>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Solution</td>
        <td class="v">#{$attempt} of {$attempts}, submitted at {$submittedAt|localizedDate:'en'}</td>
    </tr>
    <tr>
        <td class="k">Author</td>
        <td class="v">{$author}</td>
    </tr>
    <tr>
        <td class="k">Assignment</td>
        <td class="v">{$assignment}</td>
    </tr>
    <tr>
        <td class="k">Group</td>
        <td class="v">{$group}</td>
    </tr>
</table>

<p n:if="$prevAttempt">
    The new request replaced previous review request of solution #{$prevAttempt}
    (submitted at {$prevSubmittedAt|localizedDate:'en'}).
</p>

{button($link, 'Open the solution')|noescape}
