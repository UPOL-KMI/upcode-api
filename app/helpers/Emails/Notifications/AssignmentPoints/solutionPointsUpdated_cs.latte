{emailSubject}Hodnocení úlohy změněno - {$assignment}{/emailSubject}
<h1>Změna hodnocení úlohy '{$assignment}'</h1>

<p>Vaše bodové hodnocení úlohy '{$assignment}' ve skupině '{$group}' bylo změněno.</p>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Body</td>
        <td class="v">{$points} z {$maxPoints}</td>
    </tr>
    {if $hasBonusPoints}
    <tr>
        <td class="k">Bonusové body</td>
        <td class="v">{$bonusPoints}</td>
    </tr>
    {/if}
</table>

{button($link, 'Otevřít úlohu')|noescape}
