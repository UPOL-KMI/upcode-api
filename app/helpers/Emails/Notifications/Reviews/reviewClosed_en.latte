{emailSubject}Solution of {$assignment} reviewed{/emailSubject}
<h1>A solution was reviewed!</h1>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Group</td>
        <td class="v">{$group}</td>
    </tr>
    <tr>
        <td class="k">Assignment</td>
        <td class="v">{$assignment}</td>
    </tr>
    <tr>
        <td class="k">Solution</td>
        <td class="v">#{$attempt}, submitted at {$submitted|localizedDate:'en'}</td>
    </tr>
    <tr>
        <td class="k">Outcome</td>
        <td class="v">{if !$issues && !$comments}no issues and no comments{else}{count($issues) ? count($issues) : 'no'} issues to be resolved, {count($comments) ? count($comments) : 'no'} comments{/if}</td>
    </tr>
</table>

{button($codeUrl, 'Open the full review')|noescape}

{if $summary}
<h2>Review summary</h2>
<blockquote n:foreach="$summary as $summaryComment">{$summaryComment->getText()|markdown|noescape}</blockquote>
{/if}

{if $issues}
<h2>Issues to be resolved</h2>
{/if}
<div n:foreach="$issues as $issue">
    <h3>At <code>{$issue->getFile()}:{$issue->getLine()}</code></h3>
    <blockquote>{$issue->getText()|markdown|noescape}</blockquote>
</div>

{if $comments && count($comments) <= 5}
<h2>Comments</h2>
<div n:foreach="$comments as $comment">
    <h3>At <code>{$comment->getFile()}:{$comment->getLine()}</code></h3>
    <blockquote>{$comment->getText()|markdown|noescape}</blockquote>
</div>
{/if}
