{emailSubject}New Shadow Assignment - {$name}{/emailSubject}
<h1>New shadow assignment '{$name}' created</h1>

<p>
    Shadow assignments hand out study materials, or record points for work that is submitted
    outside {$siteName}.
</p>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Group</td>
        <td class="v">{$group}</td>
    </tr>
    <tr>
        <td class="k">Assignment</td>
        <td class="v">{$name}</td>
    </tr>
    {if $maxPoints}
    <tr>
        <td class="k">Maximum of points</td>
        <td class="v">{$maxPoints}</td>
    </tr>
    {/if}
</table>

{button($link, 'Open the assignment')|noescape}
