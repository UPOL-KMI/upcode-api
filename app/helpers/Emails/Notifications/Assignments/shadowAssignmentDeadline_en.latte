{emailSubject}Shadow Assignment Deadline Is Around the Corner - {$assignment}{/emailSubject}
<h1>Deadline for the shadow assignment '{$assignment}' is approaching</h1>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Group</td>
        <td class="v">{$group}</td>
    </tr>
    <tr>
        <td class="k">Assignment</td>
        <td class="v">{$assignment}</td>
    </tr>
    <tr>
        <td class="k">Deadline</td>
        <td class="v">{$deadline|localizedDate:'en'}</td>
    </tr>
</table>

{button($link, 'Open the assignment')|noescape}
