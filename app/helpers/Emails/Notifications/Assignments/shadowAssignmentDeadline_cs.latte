{emailSubject}Termín odevzdání stínové úlohy se blíží - {$assignment}{/emailSubject}
<h1>Termín odevzdání stínové úlohy '{$assignment}' se nezadržitelně blíží</h1>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Skupina</td>
        <td class="v">{$group}</td>
    </tr>
    <tr>
        <td class="k">Termín odevzdání</td>
        <td class="v">{$deadline|localizedDate:'cs'}</td>
    </tr>
</table>

{button($link, 'Otevřít zadání')|noescape}
