{emailSubject}New Assignment - '{$assignment}'{/emailSubject}
<h1>New exercise '{$assignment}' assigned</h1>

<p>A new exercise '{$assignment}' has been assigned in your group '{$group}'.</p>

<table role="presentation" class="facts" width="100%" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="k">Deadline</td>
        <td class="v">{$firstDeadline|localizedDate:'en'}</td>
    </tr>
    {if $allowSecondDeadline}
    <tr>
        <td class="k">Second deadline</td>
        <td class="v">{$secondDeadline|localizedDate:'en'}</td>
    </tr>
    {/if}
    <tr>
        <td class="k">Attempts for submission</td>
        <td class="v">{$attempts}</td>
    </tr>
    <tr>
        <td class="k">Maximum of points</td>
        <td class="v">{$points}</td>
    </tr>
</table>

{button($link, 'Open the assignment')|noescape}
